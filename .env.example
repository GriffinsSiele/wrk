# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=olynixx
# Local dev uses SQLite by default; set this for Docker/production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/olynixx

# Backend Security — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
REFRESH_SECRET_KEY=change-me-refresh-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side frontend requests (Docker network)
INTERNAL_API_URL=http://backend:8000

# Bunny.net Stream (video hosting)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=

# Redis / Celery (required for production; optional for local dev)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Exam engine defaults (overridden per ExamConfig DB row if set)
EXAM_PASS_MARK=70
EXAM_TIME_LIMIT_MINUTES=60
EXAM_MAX_ATTEMPTS=3
EXAM_RANDOMISE=true
# Default exam delivery mode
EXAM_DELIVERY_MODE=online
