# =============================================================================
# Olynixx Praxis — environment template
# Copy to .env for local Docker Compose. Never commit real secrets.
# Generate secrets:  openssl rand -hex 32
# =============================================================================

# Runtime
ENVIRONMENT=development
# development | staging | production

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=olynixx
# Local SQLite default in code; use Postgres for Docker / Azure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/olynixx

# Backend JWT — MUST be unique random values in staging/production
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
REFRESH_SECRET_KEY=change-me-refresh-secret-key
ALGORITHM=HS256
# Match frontend auth cookie (24h) until refresh-token UX is wired
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# API surface
ENABLE_DOCS=
# empty = auto (docs on in non-production, off in production)
SQL_ECHO=false
CORS_ORIGINS=http://localhost:3000
# Live demo frontend (Railway/API go-live):
# CORS_ORIGINS=https://olynixx-academy.vercel.app

# Rate limits (requests per minute per client IP)
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_LEADS_PER_MINUTE=15

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production target (Jef / PDPL): Azure UAE North — not Railway for real data.
# Scratch Railway hostnames must not appear to partners. Target API: https://api.olynixx.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example:
# NEXT_PUBLIC_SITE_URL=https://olynixx.com
# NEXT_PUBLIC_API_URL=https://api.olynixx.com
# INTERNAL_API_URL=https://api.olynixx.com
INTERNAL_API_URL=http://backend:8000
# After API is on Railway demo only (no real PII):
# INTERNAL_API_URL=https://YOUR-API.up.railway.app
# NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app
# NEXT_PUBLIC_SITE_URL=https://olynixx-academy.vercel.app

# Bunny.net Stream (video) — leave empty locally; API returns 503 until set
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=
# Exposed to the Next.js player for iframe embeds (same value as BUNNY_LIBRARY_ID)
NEXT_PUBLIC_BUNNY_LIBRARY_ID=

# Redis / Celery — optional for Phase 1 (PDF is sync). Leave empty unless workers run.
REDIS_URL=
CELERY_BROKER_URL=

# Exam engine defaults (overridden by ExamConfig DB rows when present).
# Working values until REPs UAE issues a spec — not locked in code.
EXAM_PASS_MARK=78
EXAM_QUESTION_COUNT=40
EXAM_TIME_LIMIT_MINUTES=60
EXAM_MAX_ATTEMPTS=3
EXAM_RANDOMISE=true
EXAM_DELIVERY_MODE=online
EXAM_SUBMIT_GRACE_MINUTES=2
# Phase 1 integrity (Jef)
EXAM_SECONDS_PER_QUESTION=90
EXAM_MAX_DISCONNECT_PAUSE_SECONDS=300

# Demo only: return raw forgot-password token in the API response (never in production).
RESET_TOKEN_RETURN_IN_RESPONSE=false

# Certificate PDF storage (local path or mount; Azure Blob is a later step)
CERTIFICATE_STORAGE_DIR=storage/certificates
